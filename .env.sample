# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,falcon
SQLITE_PATH=db.sqlite3

# Gluu Server 4.4.0 OIDC (replace with values from your Gluu configuration)
GLUU_OIDC_CLIENT_ID=replace-with-oidc-client-id
GLUU_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
GLUU_OIDC_ISSUER=https://falcon/replace-with-issuer
GLUU_OIDC_AUTHORIZATION_ENDPOINT=https://falcon/replace-with-authorization-endpoint
GLUU_OIDC_TOKEN_ENDPOINT=https://falcon/replace-with-token-endpoint
GLUU_OIDC_USERINFO_ENDPOINT=https://falcon/replace-with-userinfo-endpoint
GLUU_OIDC_JWKS_ENDPOINT=https://falcon/replace-with-jwks-endpoint
GLUU_OIDC_SIGN_ALGO=RS256

# Gluu SCIM API
GLUU_SCIM_BASE_URL=https://falcon/replace-with-scim-base-url
GLUU_SCIM_BEARER_TOKEN=replace-with-scim-bearer-token
GLUU_SCIM_TIMEOUT_SECONDS=10
